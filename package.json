{
  "name": "german-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:browser": "node tests/browser-smoke.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build_pwa.mjs && npm run verify:public",
    "verify:public": "node scripts/verify_public_build.mjs",
    "export:vocabulary": "node scripts/export_personal_vocabulary.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
